{
  "version": 2,
  "builds": [
    {
      "src": "frontend/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/phase2-comparison.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/real-analysis.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/phase2-comparison.html",
      "dest": "/frontend/phase2-comparison.html"
    },
    {
      "src": "/real-analysis.html",
      "dest": "/frontend/real-analysis.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
